# Copy this checklist into your production host environment.
# Do not commit real production secrets.

NODE_ENV=production
PORT=3001

# Database: prefer a managed MySQL-compatible DATABASE_URL for deploy.
# Example format:
# DATABASE_URL=mysql://user:password@host:3306/database_name
DATABASE_URL=
DB_SYNC=false
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Auth
# Use a strong unique value, at least 24 characters. Render can generate this
# automatically from render.yaml.
JWT_SECRET=
AUTH_COOKIE_NAME=tp_auth
COOKIE_SECURE=true

# Public HTTPS origin for single-origin deploy.
# Use your Render/custom domain, for example:
# https://tp-preneurs-multivendor.onrender.com
CLIENT_URL=
CORS_ORIGIN=
PUBLIC_BASE_URL=

# Runtime uploads. This is writable inside the container but not durable on
# Render free services. Use Cloudflare R2 before relying on production uploads.
UPLOAD_DIR=uploads

# Optional Duitku production config.
DUITKU_ENABLED=false
DUITKU_ENV=production
DUITKU_BASE_URL=
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CALLBACK_URL=
DUITKU_RETURN_URL=
DUITKU_TIMEOUT_MS=10000
DUITKU_CREATE_INVOICE_PATH=/api/merchant/createInvoice
