NODE_ENV=production
CLIENT_DIST_DIR=client/dist
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_COOKIE_NAME=tp_auth
COOKIE_SECURE=true
DB_SYNC=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
CLIENT_URL=https://YOUR_DOMAIN
CORS_ORIGIN=https://YOUR_DOMAIN
PUBLIC_BASE_URL=https://YOUR_DOMAIN
UPLOAD_DIR=uploads
RATE_LIMIT_DISABLED=false
DUITKU_ENABLED=false
DUITKU_ENV=production
DUITKU_BASE_URL=https://passport.duitku.com
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CALLBACK_URL=https://YOUR_DOMAIN/api/payments/duitku/callback
DUITKU_RETURN_URL=https://YOUR_DOMAIN/payments/return
DUITKU_TIMEOUT_MS=10000
DUITKU_CREATE_INVOICE_PATH=/api/merchant/createInvoice
