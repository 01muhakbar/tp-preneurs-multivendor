# Copy this file to deploy/oci/.env on the Oracle VM.
# Do not commit deploy/oci/.env.

# Public domain that points to the Oracle VM public IP.
DOMAIN=example.com
ACME_EMAIL=admin@example.com

NODE_ENV=production
PORT=3001
CLIENT_DIST_DIR=client/dist

# TiDB Cloud MySQL-compatible URL.
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DB_SYNC=false
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace_with_at_least_24_random_characters
AUTH_COOKIE_NAME=tp_auth
COOKIE_SECURE=true

# For Oracle VM, set explicit HTTPS origins because there is no platform-provided domain env.
CLIENT_URL=https://example.com
CORS_ORIGIN=https://example.com
PUBLIC_BASE_URL=https://example.com

UPLOAD_DIR=uploads
RATE_LIMIT_DISABLED=false

# Optional Duitku production config.
DUITKU_ENABLED=false
DUITKU_ENV=production
DUITKU_BASE_URL=
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CALLBACK_URL=
DUITKU_RETURN_URL=
DUITKU_TIMEOUT_MS=10000
DUITKU_CREATE_INVOICE_PATH=/api/merchant/createInvoice
